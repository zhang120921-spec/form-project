# FORM Server — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# === Required ===
# JWT secret key — must be a random string, at least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# === Optional ===
# Server port (default: 3001)
PORT=3001

# Custom database path (default: server/src/data/form.db)
# DB_PATH=./data/form.db

# === AI Features (optional) ===
# AI features gracefully degrade when no API key is configured.
# Any OpenAI-compatible API works (DeepSeek, OpenAI, etc.) — but verify the
# actual endpoint path and model names for your provider/account by calling
# GET {endpoint}/models rather than assuming; DeepSeek's real base URL has
# no /v1 suffix and its current models are deepseek-v4-flash/-pro, not the
# deepseek-chat name shown in older docs.
AI_API_KEY=sk-your-api-key-here
AI_ENDPOINT=https://api.deepseek.com
AI_MODEL=deepseek-v4-flash

# If your provider/model accepts image input for OCR scorecard capture,
# set this to true. DeepSeek's hosted API does not (verified: it rejects
# image_url content), so this defaults to off.
AI_VISION_ENABLED=false
