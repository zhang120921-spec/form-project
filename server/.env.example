# FORM Server — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# === Required ===
# JWT secret key — must be a random string, at least 32 characters.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# === Optional ===
# Server port (default: 3001)
PORT=3001

# Custom database path (default: server/src/data/form.db)
# DB_PATH=./data/form.db

# === AI Features (optional) ===
# AI features gracefully degrade when no API key is configured.
# Any OpenAI-compatible API works (DeepSeek, OpenAI, etc.)
AI_API_KEY=sk-your-api-key-here
AI_ENDPOINT=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
